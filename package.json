{
  "name": "frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build --preset cloudflare-module",
    "build:node": "nuxt build --preset node-server",
    "dev": "node ./scripts/run-nuxt.mjs dev",
    "generate": "nuxt generate",
    "preview": "wrangler dev",
    "preview:node": "node ./scripts/run-nuxt.mjs preview",
    "start": "npm run preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "postinstall": "nuxt prepare",
    "test:wallet": "node --test test/freighter-access.test.mjs"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.7.1",
    "@nuxtjs/i18n": "^10.3.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@privy-io/js-sdk-core": "0.78.2",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "16.0.0",
    "@tabler/icons-vue": "^3.44.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@vueuse/nuxt": "^14.3.0",
    "nuxt": "^4.4.5",
    "pinia": "^3.0.4",
    "tailwindcss": "^3.4.19",
    "viem": "2.56.5",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "overrides": {
    "axios": "1.20.0",
    "devalue": "6.0.3",
    "postcss-selector-parser": "7.1.7"
  },
  "devDependencies": {
    "oxc-parser": "^0.112.0",
    "wrangler": "4.153.0"
  }
}
